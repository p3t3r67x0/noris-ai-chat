# Local development values only. This file contains no provider or OIDC secrets.
POSTGRES_DB=noris_dev
POSTGRES_USER=noris_migrator
POSTGRES_PASSWORD=noris-local-development-only
NORIS_APP_DB_PASSWORD=noris-app-local-development-only
NORIS_ENVIRONMENT=development
# Optional Linux build-DNS workaround: NORIS_BUILD_NETWORK=host make dev-up
# Applies only to Dockerfile RUN instructions, not the running services.
NORIS_BUILD_NETWORK=default
NORIS_POSTGRES_PORT=55432
# Compose overrides this host with 'postgres'. Host development uses localhost.
NORIS_DATABASE_URL=postgresql+psycopg://noris_app:noris-app-local-development-only@127.0.0.1:55432/noris_dev
NORIS_MIGRATION_DATABASE_URL=postgresql+psycopg://noris_migrator:noris-local-development-only@127.0.0.1:55432/noris_dev
NORIS_READINESS_TIMEOUT_SECONDS=3
NORIS_DEV_API_TARGET=http://127.0.0.1:8000
NORIS_HTTP_PORT=8080
# Integration tests require a disposable database whose name ends in _test.
# NORIS_TEST_DATABASE_URL=postgresql+psycopg://noris_migrator:noris-local-development-only@127.0.0.1:55432/noris_test

# No provider request is made in the default Mock mode.
NORIS_LLM_PROVIDER=disabled
NUXT_PUBLIC_CHAT_TRANSPORT=mock
# Real mode: opt in, then set both secrets outside Git. See docs/ETAPPE-2-BETRIEB.md.
# NORIS_LLM_PROVIDER=openai-compatible
# NUXT_PUBLIC_CHAT_TRANSPORT=real
# NORIS_LLM_BASE_URL=https://ai.noris.de/v1
# NORIS_LLM_ALLOWED_HOSTS=["ai.noris.de"]
# NORIS_LLM_API_KEY=
# NORIS_LLM_ACCESS_USERNAME=
# NORIS_LLM_ACCESS_PASSWORD=
# NORIS_LLM_ALLOWED_ORIGINS=["http://127.0.0.1:8080","http://127.0.0.1:3000"]
# This model ID is documented by Noris; actual account access needs a live test.
# NORIS_LLM_MODELS=[{"id":"vllm/release/gpt-oss-120b","name":"GPT-OSS 120B","context_window":8192,"max_output_tokens":1024,"available":true,"streaming":true}]
# NORIS_LLM_DEFAULT_MODEL=vllm/release/gpt-oss-120b
# Deliberately use an 8192-token local policy cap below the documented 128K context.
# NORIS_LLM_TOKEN_LIMIT_PARAMETER=max_tokens
# Optional for compatible reasoning models; unset preserves provider defaults.
# NORIS_LLM_REASONING_EFFORT=low
# NORIS_LLM_CONNECT_TIMEOUT_SECONDS=5
# NORIS_LLM_READ_TIMEOUT_SECONDS=30
# NORIS_LLM_TOTAL_TIMEOUT_SECONDS=120
# NORIS_LLM_TITLE_TIMEOUT_SECONDS=6
# NORIS_LLM_TITLE_MAX_OUTPUT_TOKENS=96
# NORIS_LLM_MAX_CONCURRENT=4
# NORIS_LLM_REQUESTS_PER_MINUTE=20
# NORIS_LLM_DAILY_TOKEN_BUDGET=100000
# NORIS_LLM_MAX_REQUEST_BYTES=524288
# NORIS_LLM_MAX_UPSTREAM_BYTES=1048576
