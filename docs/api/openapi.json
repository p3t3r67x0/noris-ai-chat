{
  "components": {
    "schemas": {
      "CancelledEvent": {
        "additionalProperties": false,
        "properties": {
          "seq": {
            "minimum": 1.0,
            "title": "Seq",
            "type": "integer"
          },
          "type": {
            "const": "response.cancelled",
            "default": "response.cancelled",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "seq"
        ],
        "title": "CancelledEvent",
        "type": "object"
      },
      "ChatRequest": {
        "additionalProperties": false,
        "properties": {
          "attempt": {
            "maximum": 1000.0,
            "minimum": 1.0,
            "title": "Attempt",
            "type": "integer"
          },
          "conversationId": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]+$",
            "title": "Conversationid",
            "type": "string"
          },
          "generationId": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]+$",
            "title": "Generationid",
            "type": "string"
          },
          "inputMessageId": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]+$",
            "title": "Inputmessageid",
            "type": "string"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/LLMMessage"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Messages",
            "type": "array"
          },
          "modelId": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Modelid",
            "type": "string"
          }
        },
        "required": [
          "generationId",
          "conversationId",
          "inputMessageId",
          "modelId",
          "messages",
          "attempt"
        ],
        "title": "ChatRequest",
        "type": "object"
      },
      "CompletedEvent": {
        "additionalProperties": false,
        "properties": {
          "seq": {
            "minimum": 1.0,
            "title": "Seq",
            "type": "integer"
          },
          "type": {
            "const": "response.completed",
            "default": "response.completed",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "seq"
        ],
        "title": "CompletedEvent",
        "type": "object"
      },
      "ConversationTitleRequest": {
        "additionalProperties": false,
        "properties": {
          "conversationId": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]+$",
            "title": "Conversationid",
            "type": "string"
          },
          "firstMessage": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Firstmessage",
            "type": "string"
          },
          "inputMessageId": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]+$",
            "title": "Inputmessageid",
            "type": "string"
          },
          "modelId": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Modelid",
            "type": "string"
          }
        },
        "required": [
          "conversationId",
          "inputMessageId",
          "modelId",
          "firstMessage"
        ],
        "title": "ConversationTitleRequest",
        "type": "object"
      },
      "ConversationTitleResponse": {
        "additionalProperties": false,
        "properties": {
          "conversationId": {
            "title": "Conversationid",
            "type": "string"
          },
          "inputMessageId": {
            "title": "Inputmessageid",
            "type": "string"
          },
          "title": {
            "maxLength": 50,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "conversationId",
          "inputMessageId",
          "title"
        ],
        "title": "ConversationTitleResponse",
        "type": "object"
      },
      "DeltaEvent": {
        "additionalProperties": false,
        "properties": {
          "delta": {
            "title": "Delta",
            "type": "string"
          },
          "seq": {
            "minimum": 1.0,
            "title": "Seq",
            "type": "integer"
          },
          "type": {
            "const": "response.output_text.delta",
            "default": "response.output_text.delta",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "seq",
          "delta"
        ],
        "title": "DeltaEvent",
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "Evidence": {
        "enum": [
          "DOCUMENTED",
          "VERIFIED",
          "UNKNOWN"
        ],
        "type": "string"
      },
      "FailedEvent": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "seq": {
            "minimum": 1.0,
            "title": "Seq",
            "type": "integer"
          },
          "type": {
            "const": "response.failed",
            "default": "response.failed",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "seq",
          "code",
          "message"
        ],
        "title": "FailedEvent",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "properties": {
          "service": {
            "const": "noris-ai",
            "default": "noris-ai",
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "LLMMessage": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "maxLength": 32000,
            "title": "Content",
            "type": "string"
          },
          "role": {
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "role",
          "content"
        ],
        "title": "LLMMessage",
        "type": "object"
      },
      "LLMModel": {
        "additionalProperties": false,
        "properties": {
          "available": {
            "default": true,
            "title": "Available",
            "type": "boolean"
          },
          "category": {
            "$ref": "#/components/schemas/ModelCategory",
            "default": "UNKNOWN"
          },
          "context_window": {
            "default": 8192,
            "maximum": 2000000.0,
            "minimum": 256.0,
            "title": "Context Window",
            "type": "integer"
          },
          "cost": {
            "$ref": "#/components/schemas/ModelCost"
          },
          "description": {
            "default": "",
            "maxLength": 500,
            "title": "Description",
            "type": "string"
          },
          "documented_context_window": {
            "anyOf": [
              {
                "maximum": 2000000.0,
                "minimum": 256.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Documented Context Window"
          },
          "evidence": {
            "additionalProperties": {
              "$ref": "#/components/schemas/Evidence"
            },
            "title": "Evidence",
            "type": "object"
          },
          "id": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/:-]*$",
            "title": "Id",
            "type": "string"
          },
          "lifecycle": {
            "default": "UNKNOWN",
            "enum": [
              "LTS",
              "PRODUCTIVE",
              "EXPERIMENTAL",
              "DEPRECATED",
              "UNKNOWN"
            ],
            "title": "Lifecycle",
            "type": "string"
          },
          "max_output_tokens": {
            "default": 1024,
            "maximum": 8192.0,
            "minimum": 1.0,
            "title": "Max Output Tokens",
            "type": "integer"
          },
          "name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "provider": {
            "anyOf": [
              {
                "maxLength": 120,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider"
          },
          "reasoning": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reasoning"
          },
          "reasoning_effort": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reasoning Effort"
          },
          "reasoning_efforts": {
            "items": {
              "type": "string"
            },
            "title": "Reasoning Efforts",
            "type": "array"
          },
          "reasoning_parameter": {
            "anyOf": [
              {
                "enum": [
                  "reasoning_effort",
                  "chat_template_kwargs"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reasoning Parameter"
          },
          "released_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Released At"
          },
          "sources": {
            "items": {
              "type": "string"
            },
            "title": "Sources",
            "type": "array"
          },
          "streaming": {
            "default": true,
            "title": "Streaming",
            "type": "boolean"
          },
          "supported_output_tokens": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Supported Output Tokens"
          },
          "timeout_policy": {
            "$ref": "#/components/schemas/TimeoutPolicy"
          },
          "token_limit_parameter": {
            "anyOf": [
              {
                "enum": [
                  "max_tokens",
                  "max_completion_tokens"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Token Limit Parameter"
          },
          "tool_calling": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool Calling"
          },
          "virtual": {
            "default": false,
            "title": "Virtual",
            "type": "boolean"
          },
          "vision": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Vision"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "title": "LLMModel",
        "type": "object"
      },
      "ModelCatalog": {
        "additionalProperties": false,
        "properties": {
          "default_model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Default Model"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "expires_in_seconds": {
            "default": 0,
            "title": "Expires In Seconds",
            "type": "integer"
          },
          "fetched_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fetched At"
          },
          "models": {
            "items": {
              "$ref": "#/components/schemas/LLMModel"
            },
            "title": "Models",
            "type": "array"
          },
          "registry_version": {
            "default": "1",
            "title": "Registry Version",
            "type": "string"
          },
          "status": {
            "default": "fresh",
            "enum": [
              "fresh",
              "stale"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "models",
          "default_model"
        ],
        "title": "ModelCatalog",
        "type": "object"
      },
      "ModelCategory": {
        "enum": [
          "CHAT",
          "REASONING",
          "VISION",
          "EMBEDDING",
          "RERANKING",
          "UNKNOWN"
        ],
        "type": "string"
      },
      "ModelCost": {
        "additionalProperties": false,
        "properties": {
          "as_of": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "As Of"
          },
          "cached_input_points_per_million": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cached Input Points Per Million"
          },
          "evidence": {
            "$ref": "#/components/schemas/Evidence",
            "default": "UNKNOWN"
          },
          "input_points_per_million": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Input Points Per Million"
          },
          "output_points_per_million": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Points Per Million"
          },
          "source": {
            "default": "https://noris.cloud/nai/punkte-rechner/",
            "title": "Source",
            "type": "string"
          }
        },
        "title": "ModelCost",
        "type": "object"
      },
      "ReadinessResponse": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "ready",
            "default": "ready",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "ReadinessResponse",
        "type": "object"
      },
      "StartedEvent": {
        "additionalProperties": false,
        "properties": {
          "seq": {
            "minimum": 1.0,
            "title": "Seq",
            "type": "integer"
          },
          "type": {
            "const": "response.started",
            "default": "response.started",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "seq"
        ],
        "title": "StartedEvent",
        "type": "object"
      },
      "TimeoutPolicy": {
        "additionalProperties": false,
        "properties": {
          "read_seconds": {
            "default": 30,
            "exclusiveMinimum": 0.0,
            "maximum": 120.0,
            "title": "Read Seconds",
            "type": "number"
          },
          "total_seconds": {
            "default": 120,
            "exclusiveMinimum": 0.0,
            "maximum": 600.0,
            "title": "Total Seconds",
            "type": "number"
          }
        },
        "title": "TimeoutPolicy",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBasic": {
        "scheme": "basic",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "noris AI API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/health/live": {
      "get": {
        "description": "Process health, independent of database availability.",
        "operationId": "getLiveness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness",
        "tags": [
          "Health"
        ]
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "description": "Ready only when PostgreSQL is reachable and the baseline is applied.",
        "operationId": "getReadiness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Database or migrations unavailable"
          }
        },
        "summary": "Readiness",
        "tags": [
          "Health"
        ]
      }
    },
    "/api/v1/llm/chat": {
      "post": {
        "operationId": "streamChat",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "discriminator": {
                    "mapping": {
                      "response.cancelled": "#/components/schemas/CancelledEvent",
                      "response.completed": "#/components/schemas/CompletedEvent",
                      "response.failed": "#/components/schemas/FailedEvent",
                      "response.output_text.delta": "#/components/schemas/DeltaEvent",
                      "response.started": "#/components/schemas/StartedEvent"
                    },
                    "propertyName": "type"
                  },
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/StartedEvent"
                    },
                    {
                      "$ref": "#/components/schemas/DeltaEvent"
                    },
                    {
                      "$ref": "#/components/schemas/CompletedEvent"
                    },
                    {
                      "$ref": "#/components/schemas/CancelledEvent"
                    },
                    {
                      "$ref": "#/components/schemas/FailedEvent"
                    }
                  ],
                  "type": "string"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "408": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Request Timeout"
          },
          "409": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "413": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Content Too Large"
          },
          "415": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unsupported Media Type"
          },
          "422": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "429": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "500": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "502": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Gateway"
          },
          "503": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "504": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Gateway Timeout"
          }
        },
        "security": [
          {
            "HTTPBasic": []
          }
        ],
        "summary": "Chat",
        "tags": [
          "LLM"
        ]
      }
    },
    "/api/v1/llm/conversation-title": {
      "post": {
        "operationId": "generateConversationTitle",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConversationTitleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationTitleResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "408": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Request Timeout"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
