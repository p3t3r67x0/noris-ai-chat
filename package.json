{
  "name": "noris-ai-chat",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22.22.3 <25"
  },
  "scripts": {
    "dev": "pnpm --dir frontend dev",
    "build": "pnpm --dir frontend build",
    "lint": "pnpm --dir frontend lint",
    "typecheck": "pnpm --dir frontend typecheck",
    "typecheck:tools": "tsc --project tsconfig.tools.json",
    "test": "pnpm --dir frontend test",
    "test:e2e": "pnpm --dir frontend test:e2e",
    "api:generate": "node scripts/generate-api.mjs",
    "api:check": "node scripts/generate-api.mjs --check"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "typescript": "5.9.3",
    "json-schema-to-typescript-lite": "15.0.0"
  }
}
